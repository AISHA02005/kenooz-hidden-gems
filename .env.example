# Kenooz Frontend Environment Variables
# NOTE: rewrites in next.config.ts are evaluated at BUILD time, so API_BASE_URL
# must be set when running "npm run build".

# Flask API base URL used by the Next.js server (SSR + rewrites).
# Production on the same EC2 instance: http://127.0.0.1:5000
API_BASE_URL=http://127.0.0.1:5000

# Leave EMPTY so the browser uses same-origin /api and /uploads (via rewrites).
# NEXT_PUBLIC_* values are baked into the browser bundle: never put 127.0.0.1 here in production.
NEXT_PUBLIC_API_URL=

# Only for backend IMAGE_DELIVERY=presigned, e.g. <bucket>.s3.<region>.amazonaws.com
S3_IMAGE_HOSTNAME=