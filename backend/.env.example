# Flask Configuration
FLASK_APP=run.py
FLASK_CONFIG=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=dev-secret-key-change-in-production

# Database Configuration
# Local Development default (SQLite):
DATABASE_URL=sqlite:///kenooz.db

# Future Amazon RDS MySQL connection example:
# DATABASE_URL=mysql+pymysql://<db_user>:<db_password>@<rds_endpoint>:3306/<db_name>

# Cross-Origin Resource Sharing (CORS)
# Restrict to local Next.js frontend origin in development
CORS_ORIGINS=http://localhost:3000

# Local Upload Storage (Phase 1)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880  # 5 MB in bytes
