# ---------------- Flask ----------------
FLASK_APP=run.py
# development | testing | production  (unknown values are rejected)
FLASK_CONFIG=development
FLASK_DEBUG=True
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# Local dev placeholder only. In production this MUST be a real random value
# (>= 32 chars), e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# ---------------- Database ----------------
# Local development (default):
DATABASE_URL=sqlite:///kenooz.db
# Production (Amazon RDS MySQL). URL-encode special characters in the password:
# DATABASE_URL=mysql+pymysql://<db_user>:<url_encoded_db_password>@<rds_endpoint>:3306/<db_name>

# Leave empty for defaults: true in development/testing, false in production.
# In production, tables are created by "flask db upgrade", not at startup.
AUTO_CREATE_TABLES=

# Optional connection-pool tuning (MySQL only)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
# Optional: path to the Amazon RDS CA bundle to enable TLS verification
DB_SSL_CA=

# ---------------- CORS ----------------
CORS_ORIGINS=http://localhost:3000

# ---------------- Uploads ----------------
# Local storage folder (used when STORAGE_BACKEND=local)
UPLOAD_FOLDER=uploads


# ---------------- Image storage ----------------
# local (default, no AWS needed) | s3
STORAGE_BACKEND=local
AWS_REGION=eu-north-1
S3_BUCKET_NAME=kenooz11-gems-2026
# Objects are stored as <S3_KEY_PREFIX><image_key>
S3_KEY_PREFIX=places/
# proxy (default): Flask reads the private object and serves /uploads/<key>
# presigned: API returns short-lived presigned S3 URLs
IMAGE_DELIVERY=proxy
S3_PRESIGNED_EXPIRY=900
# Optional, e.g. AES256. Empty = rely on bucket default encryption.
S3_SERVER_SIDE_ENCRYPTION=

# NOTE: no AWS access keys here. On EC2 boto3 uses the attached IAM Role.